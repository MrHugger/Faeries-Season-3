{
  "type": "minecraft:disk",
  "config": {
    "state_provider": {
      "type" : "rule_based_state_provider",
      "fallback": {
        "type": "minecraft:simple_state_provider",
        "state": {
          "Name": "minecraft:mud_brick_wall",
          "Properties": {
            "waterlogged": "false"
          }
        }
      },
      "rules": [
        {
          "if_true": {
            "type": "minecraft:any_of",
            "predicates": [
              {
                "type": "minecraft:matching_fluids",
                "offset": [-1,0,0],
                "fluids": "#minecraft:water"
              },
              {
                "type": "minecraft:matching_fluids",
                "offset": [1,0,0],
                "fluids": "#minecraft:water"
              },
              {
                "type": "minecraft:matching_fluids",
                "offset": [0,0,-1],
                "fluids": "#minecraft:water"
              },
              {
                "type": "minecraft:matching_fluids",
                "offset": [0,0,1],
                "fluids": "#minecraft:water"
              }
            ]
          },
          "then": {
            "type": "minecraft:simple_state_provider",
            "state": {
              "Name": "minecraft:mud_brick_wall",
              "Properties": {
                "waterlogged": "true"
              }
            }
          }
        }
      ]
    },
    "radius": 0,
    "half_height": 4,
    "target": {
      "type": "minecraft:matching_blocks",
      "blocks": "minecraft:mud_brick_wall"
    }
  }
}